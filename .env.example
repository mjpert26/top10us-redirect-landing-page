# Copy to `.env` (or `.env.local`) and fill in. All VITE_* vars are inlined at
# build time and shipped to the browser — do NOT put secrets here.

# n8n webhook that looks up a lead by token and returns prefill fields (GET).
VITE_LOOKUP_URL=https://api.bigthinkcapital.com/webhook/top10us-lookup

# n8n webhook that receives the completed application (POST).
VITE_SUBMIT_URL=https://api.bigthinkcapital.com/webhook/top10us-submit

# Optional brand overrides (defaults live in src/brand/brand.ts)
VITE_BRAND_NAME=Big Think Capital
VITE_SUPPORT_PHONE=(000) 000-0000
VITE_SUPPORT_EMAIL=hello@bigthinkcapital.com
